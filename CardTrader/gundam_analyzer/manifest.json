{
  "manifest_version": 3,
  "name": "Gundam CardTrader Analyzer",
  "version": "0.10",
  "description": "Analyze expenses by set, category, and rarity on CardTrader for Gundam cards. Includes a price history graph and a list of the last 10 listings.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.cardtrader.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
  {
    "matches": [
      "https://www.cardtrader.com/*/orders/buyer_future_order*",
      "https://www.cardtrader.com/it/orders/buyer_future_order*"
    ],
    "js": ["content.js"]
  }
]
}