  "help.open": "Help for this section",
  "help.language": "<b>Language</b><br>Choose Italian, English, or Spanish for the UI. Saved in this Chrome profile.",
  "help.apiToken": "<b>How to get your CardTrader API key</b><ol><li>Sign in at <a href=\"https://www.cardtrader.com\" target=\"_blank\" rel=\"noopener\">cardtrader.com</a>.</li><li>Open <b>Profile settings → API / API Access</b>.</li><li>Create a new token (name it e.g. Crometium TCG) and <b>copy it immediately</b>.</li><li>Paste it here and click <b>Save token</b>.</li></ol>Treat the token like a password. It is required to read prices (and for Pro auto-cart).",
  "help.poll": "<b>Polling interval</b><br>How often the extension rechecks watchlist prices.<br><b>Free</b> is fixed at 20 minutes. <b>Pro / Trial</b> can use 3–5 minutes.",
  "help.cartAddress": "<b>Cart address</b><br>Used when auto-cart adds a card to the CardTrader cart (<code>/cart/add</code>). Fill name, street, ZIP, city, state/province, and country (e.g. IT).",
  "help.notifications": "<b>Notifications</b><br>Browser notifications always fire when a card drops under target.<br><b>Sound</b> (bell) is a <b>Pro</b> feature: enable the checkbox and use «Test sound» to verify.",
  "help.license": "<b>How to activate a Pro license</b><ol><li>Open the pricing page (button below) and complete checkout to receive a <b>license key</b>.</li><li>Paste the key in the field and click <b>Activate</b>.</li><li>If valid, a confirmation message appears and the badge switches to Pro.</li></ol>If you were on trial, remaining days are paused and resume if you remove the license.",
  "help.debug": "<b>Debug</b> (Pro)<br>Enable debug mode to store API request/response logs. Use «Run check now» and «Open log» to inspect errors. Tokens are masked in logs.",
