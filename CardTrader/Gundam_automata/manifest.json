{
  "manifest_version": 3,
  "name": "CardTrader Price Alert",
  "version": "1.9",
  "description": "Alert Zero/Normale con campanella; min/now; auto-cart; archivio; debug.",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://api.cardtrader.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["sound_campanella.m4a", "sound_campanella.m4r"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
