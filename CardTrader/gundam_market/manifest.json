{
  "manifest_version": 3,
  "name": "CardTrader Analyzer",
  "version": "0.10",
  "description": "Analizza i prezzi delle carte Gundam tramite le API di CardTrader.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.cardtrader.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}