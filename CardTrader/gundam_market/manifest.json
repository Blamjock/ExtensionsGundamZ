{
  "manifest_version": 3,
  "name": "CardTrader Analyzer",
  "version": "0.11",
  "description": "Analyze Gundam card prices using the CardTrader API.",
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.cardtrader.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg",
      "48": "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}